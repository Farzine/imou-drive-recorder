# ---- Imou Open Platform (Console > My App) --------------------------------
IMOU_APP_ID=lcxxxxxxxxxxxx
IMOU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Match the data centre shown in your console:
#   https://openapi.easy4ip.com/openapi      (global default)
#   https://openapi-sg.easy4ip.com/openapi   (Singapore)
#   https://openapi-fk.easy4ip.com/openapi   (Frankfurt)
#   https://openapi-or.easy4ip.com/openapi   (Oregon)
IMOU_BASE_URL=https://openapi.easy4ip.com/openapi

# ---- Webhook -------------------------------------------------------------
# Any long random string. Your callback URL becomes /hook/<this value>.
# Generate one:  python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=change-me-to-something-long-and-random

# ---- Google Drive --------------------------------------------------------
# Paste the ENTIRE contents of token.json here, on one line.
GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","token_uri":"https://oauth2.googleapis.com/token","scopes":["https://www.googleapis.com/auth/drive.file"]}
DRIVE_FOLDER_NAME=Imou Motion Clips
# DRIVE_FOLDER_ID=          # optional, overrides DRIVE_FOLDER_NAME
RETENTION_DAYS=14           # 0 disables automatic deletion

# ---- Recording -----------------------------------------------------------
STREAM_SOURCE=hls           # hls = Imou cloud (works from Render) | rtsp = LAN only
STREAM_ID=1                 # 0 = main/HD, 1 = sub/SD  (SD is kinder to the free tier)
CLIP_SECONDS=15
COOLDOWN_SECONDS=60         # ignore repeat motion from the same camera for this long
UPLOAD_SNAPSHOT=true
ALLOWED_MSG_TYPES=videoMotion,human,crossLineDetection,crossRegionDetection

# ---- LAN mode only (STREAM_SOURCE=rtsp) ----------------------------------
# CAMERA_IP=192.168.1.100
# CAMERA_USER=admin
# CAMERA_PASSWORD=          # the safety code on the sticker under the camera

LOG_LEVEL=INFO
